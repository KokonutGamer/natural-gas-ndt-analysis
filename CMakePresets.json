{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/bin/build/${presetName}",
            "installDir": "${sourceDir}/bin/install/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "base-debug",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "base-release",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug",
            "inherits": "base-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release",
            "inherits": "base-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-x64-debug",
            "displayName": "Linux x64 Debug",
            "inherits": "base-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-x64-release",
            "displayName": "Linux x64 Release",
            "inherits": "base-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "pi-arm-debug",
            "displayName": "Raspberry Pi ARM Debug",
            "inherits": "base-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "pi-arm-release",
            "displayName": "Raspberry Pi ARM Release",
            "inherits": "base-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64-debug"
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64-release"
        },
        {
            "name": "linux-x64-debug",
            "configurePreset": "linux-x64-debug"
        },
        {
            "name": "linux-x64-release",
            "configurePreset": "linux-x64-release"
        },
        {
            "name": "pi-arm-debug",
            "configurePreset": "pi-arm-debug"
        },
        {
            "name": "pi-arm-release",
            "configurePreset": "pi-arm-release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-x64-debug",
            "configurePreset": "linux-x64-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-x64-release",
            "configurePreset": "linux-x64-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "pi-arm-debug",
            "configurePreset": "pi-arm-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "pi-arm-release",
            "configurePreset": "pi-arm-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}